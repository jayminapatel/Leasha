# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environment (recreated by install.ps1) ------------------------
venv/
.venv/

# --- Local configuration: machine-specific paths, never shared -------------
.env
.env.*
!.env.example

# --- Runtime output --------------------------------------------------------
# The logs/ structure is tracked (via .gitkeep) so a fresh clone has somewhere
# to write; the contents are not.
logs/**/*
!logs/**/.gitkeep
!logs/README.txt
*.log

# --- Index data ------------------------------------------------------------
# The real index lives at DATA_PATH (a different drive) and is never committed.
# These guard against an index accidentally created inside the project folder.
KnowledgeGraphData/
index_data/
vectors/
fts/
cache/
models/
state/
*.db
*.db-wal
*.db-shm
*.lance/

# --- Test artefacts --------------------------------------------------------
tests/fixtures/**/generated/
tests/output/

# --- Editors / OS ----------------------------------------------------------
# .vscode IS committed: the shared settings enforce the utf8bom PowerShell
# encoding rule that a BOM-less file broke once already. Only per-user state
# is excluded.
.vscode/*.log
.vscode/settings.local.json

# Visual Studio. `Leasha.sln` and `Leasha.pyproj` ARE committed - they are the
# project definition. Everything below is per-user state Visual Studio writes
# beside them: window layout, breakpoints, the IntelliSense database. `.vs/`
# in particular reaches hundreds of megabytes on a project this size.
.vs/
*.suo
*.user
*.userprefs
*.sln.docstates
# Visual Studio 2022+ rewrites the solution header on first open and leaves an
# upgrade report and a copy of the originals behind. Both are per-machine noise.
UpgradeLog*.htm
Backup/

# Written by Settings when an index move is chosen, consumed by the next start.
# Per-machine state about one pending operation - see app/core/index_move.py.
pending-move.json

.idea/
*.swp
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Windows / build -------------------------------------------------------
build/
dist/
*.spec

# --- pytest scratch --------------------------------------------------------
# Set by --basetemp in pyproject.toml. pytest DELETES this folder's contents on
# every run, so never put anything real here.
.pytest_tmp/

# --- Generated test fixtures -----------------------------------------------
# Built by tests/fixtures/generate.py, never committed. Binary fixtures in git
# rot: nobody can review a .docx diff, and an editor that opens and re-saves one
# silently destroys the corruption it was meant to test.
tests/fixtures/pdf/*.pdf
tests/fixtures/office/*.docx
tests/fixtures/office/*.xlsx
tests/fixtures/office/*.pptx
tests/fixtures/email/*.eml
tests/fixtures/email/*.msg
tests/fixtures/plaintext/*.txt
tests/fixtures/plaintext/*.csv
tests/fixtures/plaintext/*.log
tests/fixtures/corrupt/*
!tests/fixtures/**/.gitkeep

# The staged install tree. Generated by `scripts/stage.py` and rebuilt from
# scratch every run - committing it would be a second copy of the source that
# drifts, which is the failure staging exists to prevent.
/Leasha/
