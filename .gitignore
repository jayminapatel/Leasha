# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Virtual environment (recreated by install.ps1) ------------------------
venv/
.venv/

# --- Local configuration: machine-specific paths, never shared -------------
.env
.env.*
!.env.example

# --- Runtime output --------------------------------------------------------
# The logs/ structure is tracked (via .gitkeep) so a fresh clone has somewhere
# to write; the contents are not.
logs/**/*
!logs/**/.gitkeep
!logs/README.txt
*.log

# tools/grab_ui.py's default --out, and test_e2e_pywinauto.py's flake
# screenshots (order 0m S3b) - generated, and a screenshot is not a diff
# anybody should be asked to review.
outputs/

# --- Index data ------------------------------------------------------------
# The real index lives at DATA_PATH (a different drive) and is never committed.
# These guard against an index accidentally created inside the project folder.
KnowledgeGraphData/
index_data/
vectors/
fts/
cache/
models/
state/
*.db
*.db-wal
*.db-shm
*.lance/

# --- Test artefacts --------------------------------------------------------
tests/fixtures/**/generated/
tests/output/

# --- Editors / OS ----------------------------------------------------------
# .vscode IS committed: the shared settings enforce the utf8bom PowerShell
# encoding rule that a BOM-less file broke once already. Only per-user state
# is excluded.
.vscode/*.log
.vscode/settings.local.json

# Visual Studio. `Leasha.sln` and `Leasha.pyproj` ARE committed - they are the
# project definition. Everything below is per-user state Visual Studio writes
# beside them: window layout, breakpoints, the IntelliSense database. `.vs/`
# in particular reaches hundreds of megabytes on a project this size.
.vs/
*.suo
*.user
*.userprefs
*.sln.docstates
# Visual Studio 2022+ rewrites the solution header on first open and leaves an
# upgrade report and a copy of the originals behind. Both are per-machine noise.
UpgradeLog*.htm
Backup/

# **A JVM crash dump, and nothing else.** Written beside the executable by the
# Java runtime `tika`/`libpff` may start; each is a few hundred KB of thread
# stacks describing a crash that has already been logged properly. `*.log`
# already covered these, and naming them means the next person to find one knows
# what it is rather than deleting a file that might have mattered.
hs_err_pid*.log
replay_pid*.log

# Test data somebody put in the project folder. **A 5MB .pst was committed and
# referenced by nothing** - not a fixture, not named in a test, just a real
# mailbox sitting in the repository. Kept on disk because it is the owner's, and
# out of git because a binary nobody can review does not belong in history.
/big.pst
*.pst
!tests/fixtures/**/*.pst

# Written by Settings when an index move is chosen, consumed by the next start.
# Per-machine state about one pending operation - see app/core/index_move.py.
pending-move.json

.idea/
*.swp
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Windows / build -------------------------------------------------------
build/
dist/
*.spec
# ...except the one Leasha's installer is built from (2026-10-05).
!packaging/leasha.spec

# --- pytest scratch --------------------------------------------------------
# Set by --basetemp in pyproject.toml. pytest DELETES this folder's contents on
# every run, so never put anything real here.
.pytest_tmp*/

# --- Generated test fixtures -----------------------------------------------
# Built by tests/fixtures/generate.py, never committed. Binary fixtures in git
# rot: nobody can review a .docx diff, and an editor that opens and re-saves one
# silently destroys the corruption it was meant to test.
tests/fixtures/pdf/*.pdf
tests/fixtures/office/*.docx
tests/fixtures/office/*.xlsx
tests/fixtures/office/*.pptx
tests/fixtures/email/*.eml
tests/fixtures/email/*.msg
tests/fixtures/plaintext/*.txt
tests/fixtures/plaintext/*.csv
tests/fixtures/plaintext/*.log
tests/fixtures/corrupt/*
!tests/fixtures/**/.gitkeep

# The staged install tree. Generated by `scripts/stage.py` and rebuilt from
# scratch every run - committing it would be a second copy of the source that
# drifts, which is the failure staging exists to prevent.
/Leasha/

# Local-only folders: other sessions' lane notes, sandbox worktrees, scratch space.
/.claude/lanes/
/.claude/worktrees/
/.worktrees/
/scratchpad/

# Rendered from the `.jsonl` ledgers by the plugin's `promptlog.py md`; each says
# "Regenerate it; never edit it". `tests/unit/test_docs_versioned.py` skips it too.
/_Knowledge/prompt_log/views/
/_Knowledge/prompt_log/*.local-untracked.jsonl.bak

# Owner, 2026-09-30: "promts dont go to github". The ledgers hold every prompt of
# every session; they stay on the laptop. Twelve (11-24 September) were tracked
# until this date and were removed from the index, not from disk.
/_Knowledge/prompt_log/
