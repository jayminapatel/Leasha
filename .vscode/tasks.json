{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install / repair environment",
      "type": "shell",
      "command": "${workspaceFolder}\\run-install.cmd",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Preflight (no downloads)",
      "type": "shell",
      "command": "${workspaceFolder}\\run-install.cmd",
      "args": ["-Preflight"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Diagnose (bundle for troubleshooting)",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["-m", "app.cli", "diagnose"],
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Doctor",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["doctor.py"],
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Doctor (quick)",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["doctor.py", "--quick"],
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Install dev tools",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["-m", "pip", "install", "-r", "requirements-dev.txt"],
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Run all tests",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "tests", "-q"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Run the whole suite (3 processes, the project's runner)",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["scripts/run_suite.py", "-j", "3"],
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Run acceptance tests for the current layer",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "tests/integration", "-v"],
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Parse-check PowerShell scripts",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\scripts\\parse-check.ps1"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "CLI: stats",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["-m", "app.cli", "stats"],
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Download models (search and rerank)",
      "type": "shell",
      "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
      "args": ["-m", "app.cli", "models", "download", "search", "rerank"],
      "problemMatcher": [],
      "presentation": { "reveal": "always" }
    },
    {
      "label": "Build the installer",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\packaging\\build.ps1"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
