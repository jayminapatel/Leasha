# Leasha's settings file, for setting up by hand (macOS, Linux, or Windows without
# install.ps1). Copy it to .env beside this file and change DATA_PATH. Nothing else is
# needed: every setting left out keeps Leasha's own default (app/core/config.py), so a
# later version's better default is not overridden by a value copied once from here.
# The window's Settings pages write the rest of this file as you change them.

# Where the index lives. A large index is about half the size of what it reads; Leasha
# warns before a run when the drive has less than 300 GB free (REQUIRED_FREE_GB).
# An SSD is strongly preferred.
DATA_PATH=D:\Leasha\Data

# Everything below is optional; uncomment a line only to change its default.
# MODEL_CACHE=D:\Leasha\Data\models        where downloaded models are kept
# LOG_PATH=D:\Leasha\Data\logs
# REQUIRED_FREE_GB=300                     warn before a run below this
# MIN_FREE_GB=5                            stop indexing below this
# CHAT_ENGINE=onnx                         onnx (inside Leasha) or ollama
# OLLAMA_URL=http://127.0.0.1:11434        only used when something is set to Ollama
