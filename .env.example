# Template only. install.ps1 writes the real .env, which is gitignored because
# every value below is machine-specific. Copy this file to .env to configure by hand.

# --- Paths -----------------------------------------------------------------
# The index location. Needs ~150GB free for a 100GB corpus; SSD strongly preferred.
DATA_PATH=D:\KnowledgeGraphData
VECTOR_PATH=D:\KnowledgeGraphData\vectors
FTS_DB=D:\KnowledgeGraphData\fts\knowledge.db
CACHE_PATH=D:\KnowledgeGraphData\cache
MODEL_CACHE=D:\KnowledgeGraphData\models
STATE_PATH=D:\KnowledgeGraphData\state
PROJECT_PATH=D:\SearchProject
LOG_PATH=D:\SearchProject\logs

# --- Models ----------------------------------------------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_ENABLED=true

# --- Optional Ollama (RAG answers and entity extraction only) --------------
# Search never calls the LLM. The app degrades gracefully when this is unreachable.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral

# --- Guards ----------------------------------------------------------------
# Indexing pauses rather than filling the disk.
MIN_FREE_GB=5
# Free-space threshold doctor.py enforces on the DATA_PATH drive.
# Kept in sync with install.ps1 -RequiredFreeGB.
REQUIRED_FREE_GB=150
